# ---------------------------------------------------------------- build output
# The hub is generated from content/*.md + src/*.ts by `make generate` into dist/.
# It is a build artifact, not source: CI rebuilds it and publishes it to Pages.
/dist/
# ...and the pre-dist/ location, so an old command line cannot dirty the tree:
/index.html

# ------------------------------------------------------------------ python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/
starter/out/
notebooks/__marimo__/

# ------------------------------------------------------------- optional tools
node_modules/
package-lock.json

# ------------------------------------------------------------------ archives
*.tar.gz
# scratch space for anything parked but not deleted
/.attic/

# ---------------------------------------------------------------------- os
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------ editors
.idea/
*.swp
*~
# .vscode/ is intentionally COMMITTED: shared build tasks and extension hints.

# ------------------------------------------------------------------ go
# cmd/pinn's embedded payload is staged by `make pinn-assets`; only the
# placeholder is committed. Stray `go build` output at the root too.
/cmd/pinn/assets/*
!/cmd/pinn/assets/.gitkeep
/pinn
/pinn.exe
