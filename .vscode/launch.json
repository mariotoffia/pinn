{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug hub build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/build.mjs",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${fileDirname}"
    }
  ]
}
